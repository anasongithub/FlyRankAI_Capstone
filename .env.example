# Environment variables — copy this to .env.local and fill in values.
# Never commit .env.local to the repository.

# TMDB API (https://www.themoviedb.org/settings/api)
# Optional — without it, the app uses the built-in mock movie database.
TMDB_API_KEY=

# Anthropic / Claude API (https://console.anthropic.com)
# Required for the AI Assistant route (/ai) in the capstone.
ANTHROPIC_API_KEY=

# Your deployment URL — used by server components that need an absolute URL.
# On Vercel this is set automatically via VERCEL_URL; only override if needed.
NEXT_PUBLIC_APP_URL=http://localhost:3000
